# Copia este archivo como backend/.env y completa los valores. backend/.env NUNCA se sube al repositorio.

NODE_ENV=development
# 127.0.0.1 en la máquina; en Docker usa 0.0.0.0 (lo fija docker-compose).
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Saltos de proxy delante del backend: Netlify + Tailscale Funnel = 2. En local: 0.
TRUST_PROXY=0
# Orígenes permitidos para CORS (separados por coma). Solo hace falta en desarrollo local.
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MINUTE=120

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secreta: ignora RLS. Solo vive aquí.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Solo si el proyecto todavía firma tokens con el JWT secret legado (HS256). Si usa JWT Signing Keys, déjalo vacío.
# SUPABASE_JWT_SECRET=
